# The prepared call of the demo case, backed up before any run: the arguments
# are fixed, the result is declared, and it already carries what it measured.
# A run handed this directory as its prepare backup replays the 5 instead of
# measuring again.
value =
    $call (
        $victim ($x 0 * $y 0)
      * $suspect ($x 3 * $y 4)
      * $at "12:30"
    )
  * $measured 5
