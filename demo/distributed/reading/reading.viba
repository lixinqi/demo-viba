# The reading program: five calls, one service for each of them.
#
# Every call runs at a sub-environment of its own, directly below the program's own
# environment, and its name says what the call is (`root/taken`, `root/factored`, …).
# That path is the call's storage path: it answers one call, the service records the
# result under it, and the work order for that call goes under it
# (`distributed/service.py`).
#
# One service, one operation: `gauge.viba` takes the reading, `factor.viba` converts it,
# `label.viba` writes it, `length.viba` counts the label, and `check.viba` says whether
# that count is over the limit. Each file beside this one holds exactly one leaf, and each
# of those five leaves answers a different type — int, float, str, int, bool — so the
# chain changes type five times.
#
# `spare` is written and never asked for: `__impl__` is `checked`, and viba computes a
# definition only when something needs it. A program can therefore state a call that no
# round ever takes.
__decl__ = int <- $env Env

args = __get_args__ << __decl__

import gauge
import factor
import label
import length
import check

taken = gauge.take << $env ($sub_env << args.env << "taken") << $x 5
factored = factor.times << $env ($sub_env << args.env << "factored") << $x taken
labelled = label.write << $env ($sub_env << args.env << "labelled") << $x factored
counted = length.count << $env ($sub_env << args.env << "counted") << $x labelled
checked = check.over << $env ($sub_env << args.env << "checked") << $x counted

spare = factor.times << $env ($sub_env << args.env << "spare") << $x taken

__impl__ = checked
