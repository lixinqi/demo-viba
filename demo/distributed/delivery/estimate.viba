# The delivery program: a chain of calls the three services take turns at.
#
# Every call runs at a sub-environment of its own, all of them below the one named
# `order` (`root/order/weight`, `root/order/handling`, …). That path is the call's
# storage path: it answers one call, the service records the result under it, and the
# work order for that call goes under it (`distributed/service.py`).
#
# Each service's api is defined in that service's own file and imported here:
# `parcels.viba` holds the parcels service's two leaves, `couriers.viba` the couriers
# service's one, and `notices.viba` the notices service's two. One leaf is impure — the
# weight is drawn off the scale in the process that owns it — and the others are pure;
# either way the first result is recorded, and every later run replays it.
#
# The calls are a chain: each one's argument is the call before it, so the three services
# take turns, and no one of them can finish the program alone.
__decl__ = int <- $env Env

args = __get_args__ << __decl__

import parcels
import couriers
import notices

order = args.env.sub_env << args.env << "order"

w0 = parcels.read_scale << $env (order.sub_env << order << "weight") << $x 2
w1 = parcels.add_handling << $env (order.sub_env << order << "handling") << $x w0
w2 = couriers.days_for << $env (order.sub_env << order << "days") << $x w1
w3 = notices.announce << $env (order.sub_env << order << "notice") << $x w2
w4 = notices.emphasize << $env (order.sub_env << order << "title") << $x w3

__impl__ = w4
